# Copie para .env e ajuste. O .env NUNCA é versionado (.gitignore). Nada aqui é segredo real.
# Em PRODUÇÃO (Vercel) estas variáveis são cadastradas no painel da Vercel — veja docs/deploy.md.

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# DESENVOLVIMENTO: SQLite local (caminho relativo à raiz do projeto).
DATABASE_URL="file:./dev.db"
# PRODUÇÃO (Neon/Postgres): URL "pooled" (host com "-pooler"), usada pelo app em runtime:
# DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# URL DIRETA (mesmo host SEM "-pooler"), usada só por migrations/seed/backup. Só em produção:
# DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# (Opcional) conexões por instância no Postgres. Padrão 5.
# DB_POOL_MAX=5

# ---------------------------------------------------------------------------
# Autenticação
# ---------------------------------------------------------------------------
# Segredo para assinar a sessão (mín. 32 caracteres). Em produção use um valor NOVO e aleatório
# (o valor de exemplo abaixo é recusado em produção). Gere com: openssl rand -base64 32
# (sem openssl: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET="dev-only-secret-troque-em-producao-min-32-chars"

# ---------------------------------------------------------------------------
# Usuário inicial
# ---------------------------------------------------------------------------
# DESENVOLVIMENTO: criado por `npm run db:seed` (senha fraca de propósito; o script recusa NODE_ENV=production).
SEED_USER_EMAIL="admin@lavajato.local"
SEED_USER_NAME="Administrador"
SEED_USER_PASSWORD="troque-esta-senha"

# PRODUÇÃO: criado por `npm run db:seed:prod` (ver docs/deploy.md). NÃO grave a senha em arquivo:
# informe no terminal só na hora de rodar. Mín. 12 caracteres, sem senhas comuns.
# ADMIN_EMAIL="dono@seudominio.com.br"
# ADMIN_NAME="Nome do dono"          # opcional (padrão: Administrador)
# ADMIN_PASSWORD="defina-no-terminal"

# ---------------------------------------------------------------------------
# Scripts locais contra produção
# ---------------------------------------------------------------------------
# `npm run db:prod:deploy`, `db:seed:prod` e `db:backup` leem DATABASE_URL/DIRECT_URL do arquivo
# .env.production.local (também ignorado pelo git) — nunca do .env de desenvolvimento.
# BACKUP_DIR="backups"   # pasta do `npm run db:backup` (padrão: backups/, ignorada pelo git)
